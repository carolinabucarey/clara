# YouCam API key (V2): https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# Optional: override the YouCam API host
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Anthropic API key, used to read garment attributes and draft the verdict text
ANTHROPIC_API_KEY=

# Optional: cache YouCam results on disk to save API units (always on in `next dev`)
# YOUCAM_CACHE=1

# Optional: accounts (sign-in, saved looks and profile). Without these, Clara stores nothing.
# Supabase project → Settings → API. Run supabase/migrations/0001_accounts.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: lets DELETE /api/account delete the auth user. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
